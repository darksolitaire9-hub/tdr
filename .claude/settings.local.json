{
  "permissions": {
    "allow": [
      "Bash(flutter --version)",
      "PowerShell(flutter *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Get-ChildItem *)",
      "Skill(git-expert)",
      "PowerShell($env:PATH -split \";\" | Where-Object { $_ -match \"flutter|dart|android\" })",
      "PowerShell(winget search *)",
      "PowerShell(scoop list *)",
      "Bash(flutter pub *)",
      "Bash(flutter analyze *)",
      "Bash(dart run *)",
      "Bash(flutter test *)"
    ]
  }
}
